alerting:
  telegram:
    token: "{{ gatus_telegram_bot_token }}"
    id: "{{ gatus_telegram_chat_id }}"
    default-alert:
      send-on-resolved: true
      failure-threshold: 3
      success-threshold: 2

endpoints:
{% for service in services.services | selectattr('url', 'defined') %}
  - name: "{{ service.name }}"
    group: services
    url: "{{ service.protocol | default('https') }}://{{ service.url }}"
    interval: 1m
    conditions:
      - "[STATUS] < 500"
{% if service.tls_skip_verify | default(false) %}
    client:
      insecure: true
{% endif %}
    alerts:
      - type: telegram
{% endfor %}

  - name: "Mousehole Cookie State"
    group: smoke
    url: "https://mousehole.julianverse.net/state"
    interval: 1m
    conditions:
      - "[STATUS] == 200"
      - "[BODY].hasCookie == true"
      - "[BODY].lastMamContact.reached == true"
    alerts:
      - type: telegram

  - name: "Photo Sync - Julian"
    group: photos
    url: "http://{{ hostvars['daphne'].ansible_host }}:8099/photo_freshness/julian"
    interval: 1h
    client:
      timeout: 120s
    conditions:
      - "[STATUS] == 200"
      - "[BODY].fresh == true"
    alerts:
      - type: telegram
        description: "No new photos in iPhoneUploads for 5+ days - check PhotoSync on Julian's phone"

  - name: "Photo Sync - Briana"
    group: photos
    url: "http://{{ hostvars['daphne'].ansible_host }}:8099/photo_freshness/briana"
    interval: 1h
    client:
      timeout: 120s
    conditions:
      - "[STATUS] == 200"
      - "[BODY].fresh == true"
    alerts:
      - type: telegram
        description: "No new photos in briana folder for 5+ days - check PhotoSync on Briana's phone"

{% for host in groups['vms'] + groups['linuxhosts'] + groups['truenasvms'] + groups['otherhosts'] %}
{% if hostvars[host].exporter_port is defined %}
  - name: "{{ host }}"
    group: hosts
    url: "http://{{ hostvars[host].ansible_host }}:{{ hostvars[host].exporter_port }}/"
    interval: 1m
    conditions:
      - "[STATUS] < 500"
      - "[RESPONSE_TIME] < 5000"
    alerts:
      - type: telegram
{% endif %}
{% endfor %}
