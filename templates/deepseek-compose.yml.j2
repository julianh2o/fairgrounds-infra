services:
  deepseek:
    image: ollama/ollama:latest
    container_name: deepseek
    restart: unless-stopped
    ports:
      - "11435:11434"
    environment:
      - OLLAMA_KEEP_ALIVE=10m
      - OLLAMA_MAX_LOADED_MODELS=1
      - OLLAMA_NUM_PARALLEL=1
    volumes:
      - ./data:/root/.ollama
    healthcheck:
      test: ["CMD", "ollama", "list"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 20s

  deepseek-pull:
    image: ollama/ollama:latest
    container_name: deepseek-pull
    restart: "no"
    depends_on:
      deepseek:
        condition: service_healthy
    environment:
      - OLLAMA_HOST=deepseek:11434
    entrypoint: ["ollama", "pull", "{{ deepseek_model | default('deepseek-r1:1.5b') }}"]
