services:
  traccar:
    image: traccar/traccar:latest
    container_name: traccar
    restart: unless-stopped
    # Explicit JVM heap bounds; the default (1/4 of RAM) let Traccar grow to ~1.2 GB and OOM daphne.
    command: ["-Xms256m", "-Xmx512m", "-jar", "tracker-server.jar", "conf/traccar.xml"]
    mem_limit: 768m
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:8082/api/health"]
      interval: 2m
      start_period: 1h
    ports:
      - "8082:8082"
      - "5000-5150:5000-5150"
      - "5000-5150:5000-5150/udp"
    volumes:
      - ./logs:/opt/traccar/logs:rw
      # Traccar's embedded H2 database (conf/traccar.xml points at ./data/database)
      - ./data:/opt/traccar/data:rw

  autoheal:
    image: willfarrell/autoheal:latest
    container_name: traccar-autoheal
    restart: unless-stopped
    environment:
      - AUTOHEAL_CONTAINER_LABEL=all
      - AUTOHEAL_INTERVAL=60
      - AUTOHEAL_START_PERIOD=3600
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
