$py  = "{{ comfyui_venv_python }}"
$wd  = "{{ comfyui_install_dir }}"
# schtasks /end only kills this powershell; the venv launcher's python child survives and keeps
# the port. This script runs under the task's own token, so it can clear that orphan itself.
Get-NetTCPConnection -LocalPort {{ comfyui_port }} -State Listen -ErrorAction SilentlyContinue |
  ForEach-Object { Get-Process -Id $_.OwningProcess -ErrorAction SilentlyContinue } |
  Where-Object { $_.ProcessName -eq 'python' } |
  ForEach-Object { taskkill.exe /PID $_.Id /T /F | Out-Null }
Start-Sleep 2
$argline = 'main.py --listen 0.0.0.0 --port {{ comfyui_port }} --base-directory "{{ comfyui_base_directory }}" --extra-model-paths-config "{{ comfyui_extra_model_paths_config }}"'
# Redirect via Start-Process so python gets real file handles. Piping a native exe through
# PowerShell (*>>) in a hidden S4U task leaves stderr unflushable: tqdm's flush raises
# OSError 22 and every sampler node fails.
$p = Start-Process -FilePath $py -ArgumentList $argline -WorkingDirectory $wd -NoNewWindow -PassThru `
  -RedirectStandardOutput "{{ comfyui_log_path }}" `
  -RedirectStandardError "{{ comfyui_err_log_path }}"
# kvasir-svc ("comfy stop", the board's toggle) drops this flag. Only this task's token may kill
# the python tree, so the kill happens here.
$flag = "{{ comfyui_stop_flag }}"
Remove-Item $flag -ErrorAction SilentlyContinue
while (-not $p.HasExited) {
  if (Test-Path $flag) {
    taskkill.exe /PID $p.Id /T /F | Out-Null
    Remove-Item $flag -ErrorAction SilentlyContinue
    break
  }
  Start-Sleep 2
}
