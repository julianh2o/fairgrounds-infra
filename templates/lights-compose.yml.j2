services:
  daemon:
    # lightd: runs Lua patterns on WLED controller channels and owns ./config
    # (controllers.json, patterns/, lightd-state.json), edited through the web UI's /config page.
    image: julianh2o/bawdy-lights-daemon:latest
    container_name: bawdy-lights-daemon
    # Host networking so lightd can discover WLED boards over mDNS and reach them over DDP
    network_mode: host
    environment:
      - LIGHTD_HOST=0.0.0.0
      - LIGHTD_PORT=8765
      - LIGHTD_FPS=30
    volumes:
      # Read-write: lightd (uid 10001) saves its configuration here
      - ./config:/config
    stop_grace_period: 10s
    restart: unless-stopped

  web:
    image: julianh2o/bawdy-lights-web:latest
    container_name: bawdy-lights-web
    network_mode: host
    environment:
      - SEQUENCER_HOST=0.0.0.0
      - SEQUENCER_PORT=2060
      - ENGINE_URL=http://127.0.0.1:8765
      # Pattern assistant: chat under the editor. Prefers Strata (Qwen3.8-Flash-Next on kvasir,
      # github.com/Niko1221/Strata) when it's healthy, auto-falls back to the local Ollama model
      # otherwise (qwen-abliterated-48k = huihui_ai/Qwen3.8-abliterated with a 48k context).
      - ASSISTANT_BASE_URL=http://10.10.0.40:11434/v1
      - ASSISTANT_MODEL=qwen-abliterated-48k
      - ASSISTANT_DISPLAY_NAME=Qwen Abliterated 48k
      - ASSISTANT_REASONING_EFFORT=low
      - STRATA_BASE_URL=http://10.10.0.40:8080/v1
      - STRATA_MODEL=qwen3.8-flash-next-q2_0
      - STRATA_DISPLAY_NAME=Qwen3.8 Flash Next (Strata)
      - STRATA_API_KEY={{ strata_api_key }}
      # Dashboard (/): drives HA bulbs server-side; the token never reaches the browser
      - HA_URL=http://10.10.0.30:8123
      - HA_TOKEN={{ lights_homeassistant_token }}
    volumes:
      - ./sequences:/data/sequences
    depends_on:
      daemon:
        condition: service_healthy
    restart: unless-stopped
